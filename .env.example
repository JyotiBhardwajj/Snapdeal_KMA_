# Copy to .env for local development:  cp .env.example .env
# Never commit .env.

# --- Option A (default): Vertex AI, authenticated with Application Default Credentials ---
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Option B: Gemini API key from Google AI Studio (https://aistudio.google.com/apikey) ---
# If set, this takes precedence over Vertex AI. Model names differ on this API, e.g.
# LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# GEMINI_API_KEY=

# Speech-to-speech model and voice.
LIVE_MODEL=gemini-3.8-live
VOICE_NAME=Kore

# Optional tuning (unset = Live API defaults).
# TEMPERATURE=0.7
# VAD_START_SENSITIVITY=LOW
# VAD_END_SENSITIVITY=LOW
# VAD_SILENCE_MS=700

# Guard rails for a public demo.
MAX_CALL_SECONDS=600
MAX_CONCURRENT_CALLS=4
# Extra browser origins allowed to open the voice WebSocket (comma-separated).
# ALLOWED_ORIGINS=https://my-custom-domain.example

LOG_LEVEL=INFO
